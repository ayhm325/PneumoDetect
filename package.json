{
  "type": "module",
  "name": "detect-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"cross-env AI_USE_MOCK=false next dev\" \"cross-env NODE_ENV=development AI_USE_MOCK=false node scripts/socket-server.js\" \"npm run dev:model\"",
    "dev:next": "cross-env AI_USE_MOCK=false next dev",
    "dev:with-socket": "concurrently \"cross-env AI_USE_MOCK=false next dev\" \"cross-env NODE_ENV=development AI_USE_MOCK=false node scripts/socket-server.js\" \"npm run dev:model\"",
    "dev:model": "node scripts/start-python-model.mjs",
    "check:model": "node scripts/check-model-server.mjs",
    "build": "next build",
    "start": "node scripts/check-env.mjs && next start",
    "lint": "eslint",
    "test": "jest",
    "test:e2e": "npm run check:model && npx playwright test playwright-tests/analysis-e2e.spec.js --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:watch": "npm run check:model && chokidar \"playwright-tests/**/*.{js,ts,mjs,tsx}\" -c \"npx playwright test --project=chromium\" --initial",
    "dev:e2e": "concurrently \"npm run dev\" \"npm run test:e2e:watch\"",
    "postinstall": "npx prisma generate",
    "docs": "openapi-generator-cli generate -i openapi.yaml -g html -o docs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@prisma/client": "^6.19.1",
    "@socket.io/redis-adapter": "^8.1.0",
    "accept-language": "^3.0.20",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "formidable": "^3.5.4",
    "framer-motion": "^12.23.25",
    "ioredis": "^5.8.2",
    "jose": "^4.15.9",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.1.0",
    "next-intl": "^4.6.1",
    "react": "19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swr": "^2.3.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@openapitools/openapi-generator-cli": "^2.25.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/react": "19.2.7",
    "babel-jest": "^30.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.6",
    "jest": "^30.2.0",
    "next-test-api-route-handler": "^5.0.3",
    "playwright": "^1.57.0",
    "prisma": "^6.19.1",
    "supertest": "^7.1.4",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  },
  "eslintConfig": {
    "extends": "next/core-web-vitals",
    "ignorePatterns": [
      ".next/",
      "out/",
      "build/",
      "next-env.d.ts",
      ".venv/",
      "python_model/venv/",
      "**/__pycache__/**"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
